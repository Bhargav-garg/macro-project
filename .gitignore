# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Compiled distribution (regenerate with: python build.py)
dist/*
!dist/.gitkeep
.Python
*.egg-info/
build/
*.spec

# Node / npm (not used but good practice)
node_modules/
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Temp
*.tmp
*.bak
*.gitconfig_temp
